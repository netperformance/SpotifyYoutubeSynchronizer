# ---- Spotify (https://developer.spotify.com/dashboard) ----
# App anlegen, "Web API" auswaehlen.
# Redirect URI im Dashboard exakt eintragen: http://127.0.0.1:8000/callback/spotify
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/callback/spotify

# ---- Google / YouTube (https://console.cloud.google.com) ----
# 1. Projekt anlegen
# 2. "YouTube Data API v3" aktivieren
# 3. OAuth-Zustimmungsbildschirm konfigurieren (Testnutzer = deine Mailadresse)
# 4. Anmeldedaten -> OAuth-Client-ID -> Typ "Webanwendung"
#    Autorisierte Redirect-URI exakt: http://127.0.0.1:8000/callback/youtube
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/callback/youtube

# ---- App ----
# Beliebiger langer Zufallsstring fuer die Session-Signatur
SECRET_KEY=bitte-aendern-langer-zufallsstring
# Speicherort der SQLite-Datenbank (Tokens + Match-Cache)
DB_PATH=sync.db
